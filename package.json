{
  "name": "care-relay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "check:fixture": "tsx scripts/generate-fixture.ts --check",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "test:worker": "npm run build && npm run test:worker:built",
    "test:worker:built": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && npm run test:browser:built",
    "test:browser:built": "playwright test",
    "test:all": "npm run test:unit && npm run build && npm run test:worker:built && npm run test:browser:built",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "generate:fixture": "tsx scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "next": "16.2.11",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "1.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@playwright/test": "1.62.0",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
